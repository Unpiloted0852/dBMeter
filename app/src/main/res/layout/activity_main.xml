<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/root"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    tools:context=".MainActivity">

    <!-- Update offer (hidden unless GitHub has a newer release) -->
    <TextView
        android:id="@+id/tvUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Top Section: Decibel Display -->
    <TextView
        android:id="@+id/tvDecibel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0"
        android:textSize="96sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/tvUpdate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"
        app:layout_goneMarginTop="32dp"/>

    <TextView
        android:id="@+id/tvUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="dBA"
        android:textSize="24sp"
        android:textColor="#AAAAAA"
        app:layout_constraintTop_toBottomOf="@id/tvDecibel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- OSHA Warning (Hidden by default) -->
    <TextView
        android:id="@+id/tvWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ OSHA WARNING: LIMIT EXPOSURE"
        android:textSize="16sp"
        android:textColor="#F44336"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/tvUnit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Bottom Section: Level Bar Container -->
    <FrameLayout
        android:id="@+id/barContainer"
        android:layout_width="80dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvWarning"
        app:layout_constraintBottom_toTopOf="@id/tvExample"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">

        <!-- Background Bar with Gradient -->
        <View
            android:id="@+id/viewBarBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_background"/>

        <!-- Slider Indicator -->
        <View
            android:id="@+id/viewSlider"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="#FFFFFF"
            android:layout_gravity="bottom"/>
    </FrameLayout>

    <!-- Example Text at Bottom -->
    <TextView
        android:id="@+id/tvExample"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waiting for sound..."
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/graphView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"/>

    <!-- Graph View -->
    <com.example.dbmeter.GraphView
        android:id="@+id/graphView"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="#0D0D0D"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvStats"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"/>

    <!-- Statistics Text -->
    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Max: --  |  Min: --  |  Leq: --"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"/>

    <!-- Weighting, response, calibration, reset -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnWeighting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="dBA"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:maxLines="1"
            android:backgroundTint="#444444"/>
        <Button
            android:id="@+id/btnResponse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Fast"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:maxLines="1"
            android:backgroundTint="#444444"/>
        <Button
            android:id="@+id/btnCalibrate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Calibrate"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:maxLines="1"
            android:backgroundTint="#444444"/>
        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Reset"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:maxLines="1"
            android:backgroundTint="#444444"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>